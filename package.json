{
  "name": "@thiepn/go",
  "private": true,
  "version": "1.0.0-rc.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/finalize-service-worker.mjs && node scripts/finalize-release-metadata.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "katago:bridge": "node server/katago-bridge.mjs",
    "check:server": "node --check server/katago-bridge.mjs && node --check api/katago/analyze.js && node --check api/katago/health.js",
    "check:platform": "node --check public/sw.js && node scripts/check-platform.mjs",
    "check:a11y": "node scripts/check-accessibility.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "qa:browser": "playwright test",
    "check:release": "node scripts/check-release-baseline.mjs",
    "qa:canonical": "playwright test tests/e2e/canonical-deploy.e2e.ts --project=chromium-mobile",
    "qa:katago:live": "node scripts/check-katago-live.mjs",
    "qa:account:public": "playwright test tests/e2e/account-production.e2e.ts --project=chromium-mobile",
    "qa:account:credentialed": "playwright test tests/e2e/account-credentialed.e2e.ts --project=chromium-mobile",
    "check:c4": "node scripts/check-c4.mjs",
    "qa:c4:emulation": "playwright test -c playwright.c4.config.ts",
    "preview": "vite preview",
    "check:c5": "node scripts/check-c5.mjs",
    "qa:c5:accessibility": "playwright test -c playwright.c5.config.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": "22.x"
  }
}

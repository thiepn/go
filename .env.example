# Web/Vercel proxy -> external KataGo bridge.
KATAGO_BRIDGE_URL=http://127.0.0.1:2719
KATAGO_BRIDGE_TOKEN=replace-with-a-long-random-secret
KATAGO_PROXY_TIMEOUT_MS=120000
KATAGO_MAX_VISITS=1000

# External bridge host only.
KATAGO_BIN=katago
KATAGO_CONFIG=./server/katago-analysis.cfg
KATAGO_MODEL=/absolute/path/to/katago-model.bin.gz
# Optional. Enables humanPolicy when P11 requests a humanSLProfile.
KATAGO_HUMAN_MODEL=/absolute/path/to/human-model.bin.gz
KATAGO_TIMEOUT_MS=120000
KATAGO_MAX_PENDING=32
PORT=2719
HOST=127.0.0.1
